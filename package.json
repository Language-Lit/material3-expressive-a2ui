{
  "name": "@language-lit/material3-expressive-a2ui",
  "version": "0.2.0",
  "description": "Material 3 Expressive renderer for Google's A2UI protocol — a React catalog that maps every A2UI basic-catalog component onto Material 3 Expressive, plus a surface renderer and a message-processor hook.",
  "license": "MIT",
  "homepage": "https://m3e.language-lit.com/a2ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Language-Lit/material3-expressive-a2ui.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/add-directives.mjs && npm run build:styles",
    "build:styles": "node scripts/build-styles.mjs",
    "catalog:generate": "npm run build && node scripts/generate-material-catalog.mjs",
    "dev": "tsup --watch",
    "playground": "vite --config playground/vite.config.ts --port 5373 --strictPort",
    "playground:build": "vite build --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "verify:catalog": "node scripts/generate-material-catalog.mjs --check",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run verify:package && npm run verify:catalog"
  },
  "peerDependencies": {
    "@a2ui/web_core": "^0.10.7 || ^0.11.0",
    "@language-lit/material3-expressive": "^1.2.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@a2ui/react": "^0.11.1",
    "@a2ui/web_core": "0.11.0",
    "@language-lit/material3-expressive": "^1.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "20.19.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "^29.1.1",
    "lightningcss": "1.32.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "8.1.5",
    "vitest": "4.1.11"
  },
  "keywords": [
    "a2ui",
    "agent-to-user-interface",
    "google-a2ui",
    "a2ui-renderer",
    "agent-ui",
    "ai-agents",
    "generative-ui",
    "a2a",
    "material-design",
    "material-3",
    "material-3-expressive",
    "react",
    "design-system"
  ],
  "browserslist": [
    "Chrome >= 120",
    "Edge >= 120",
    "Firefox >= 121",
    "Safari >= 17.2",
    "iOS >= 17.2"
  ]
}

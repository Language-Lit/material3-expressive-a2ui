  {
    "name": "test_v10_update_data_model_deletion",
    "description": "Tests that updating a path with value null deletes the key from the data model in v1.0.",
    "action": "process_messages",
    "protocolVersion": "1.0",
    "catalogPaths": [
      "catalogs/basic/v1/catalog.json"
    ],
    "messages": [
      {
        "version": "1.0",
        "createSurface": {
          "surfaceId": "s_v10_del",
          "catalogId": "test-catalog-v10",
          "dataModel": {
            "user": {
              "name": "Alice",
              "temporaryToken": "abc123xyz"
            }
          }
        }
      },
      {
        "version": "1.0",
        "updateDataModel": {
          "surfaceId": "s_v10_del",
          "path": "/user/temporaryToken",
          "value": null
        }
      }
    ],
    "expect": {
      "surfaces": {
        "s_v10_del": {
          "dataModel": {
            "user": {
              "name": "Alice"
            }
          }
        }
      }
    }
  },
  {
    "name": "test_batch_multi_stage_lifecycle_pipeline",
    "description": "Verifies create, component update, data update, and component mutation within a single batch array.",
    "action": "process_messages",
    "protocolVersion": "1.0",
    "messages": [
      {
        "version": "1.0",
        "createSurface": {
          "surfaceId": "s_pipeline",
          "catalogId": "test-catalog-v10"
        }
      },
      {
        "version": "1.0",
        "updateComponents": {
          "surfaceId": "s_pipeline",
          "components": [
            {
              "id": "root",
              "component": "Column",
              "children": [
                "text1"
              ]
            },
            {
              "id": "text1",
              "component": "Text",
              "text": "Initial"
            }
          ]
        }
      },
      {
        "version": "1.0",
        "updateDataModel": {
          "surfaceId": "s_pipeline",
          "path": "/status",
          "value": "ready"
        }
      },
      {
        "version": "1.0",
        "updateComponents": {
          "surfaceId": "s_pipeline",
          "components": [
            {
              "id": "text1",
              "component": "Text",
              "text": "Updated"
            }
          ]
        }
      }
    ],
    "expect": {
      "surfaces": {
        "s_pipeline": {
          "exists": true,
          "dataModel": {
            "status": "ready"
          },
          "components": [
            {
              "id": "root",
              "component": "Column"
            },
            {
              "id": "text1",
              "component": "Text"
            }
          ]
        }
      }
    }
  },
  {
    "name": "test_delete_non_existent_surface_is_safe_noop",
    "description": "Verifies deleting a non-existent surface ID executes cleanly as a no-op.",
    "action": "process_messages",
    "protocolVersion": "1.0",
    "messages": [
      {
        "version": "1.0",
        "deleteSurface": {
          "surfaceId": "non_existent_surface_id"
        }
      }
    ],
    "expect": {
      "surfaces": {
        "non_existent_surface_id": {
          "exists": false
        }
      }
    }
  },
  {
    "name": "test_v10_update_components_stores_component_metadata",
    "description": "Tests that v1.0 updateComponents keeps ComponentCommon.metadata apart from component properties and exposes it as component metadata.",
    "action": "process_messages",
    "protocolVersion": "1.0",
    "catalogPaths": [
      "catalogs/basic/v1/catalog.json"
    ],
    "messages": [
      {
        "version": "1.0",
        "createSurface": {
          "surfaceId": "s_v10_comp_meta",
          "catalogId": "test-catalog-v10",
          "metadata": {
            "extensions": {
              "com_example_session": "abc"
            }
          }
        }
      },
      {
        "version": "1.0",
        "updateComponents": {
          "surfaceId": "s_v10_comp_meta",
          "components": [
            {
              "id": "root",
              "component": "Text",
              "text": "Hello",
              "metadata": {
                "extensions": {
                  "com_example_trace": "t1"
                }
              }
            }
          ]
        }
      }
    ],
    "expect": {
      "surfaces": {
        "s_v10_comp_meta": {
          "exists": true,
          "metadata": {
            "extensions": {
              "com_example_session": "abc"
            }
          },
          "components": [
            {
              "id": "root",
              "component": "Text",
              "text": "Hello",
              "@metadata": {
                "extensions": {
                  "com_example_trace": "t1"
                }
              }
            }
          ]
        }
      }
    }
  },
  {
    "name": "test_v10_update_components_replaces_component_metadata",
    "description": "Tests that a later v1.0 updateComponents entry replaces a component's metadata in full rather than merging it.",
    "action": "process_messages",
    "protocolVersion": "1.0",
    "catalogPaths": [
      "catalogs/basic/v1/catalog.json"
    ],
    "messages": [
      {
        "version": "1.0",
        "createSurface": {
          "surfaceId": "s_v10_comp_meta_replace",
          "catalogId": "test-catalog-v10"
        }
      },
      {
        "version": "1.0",
        "updateComponents": {
          "surfaceId": "s_v10_comp_meta_replace",
          "components": [
            {
              "id": "root",
              "component": "Text",
              "text": "Hello",
              "metadata": {
                "extensions": {
                  "com_example_trace": "t1",
                  "com_example_state": "draft"
                }
              }
            }
          ]
        }
      },
      {
        "version": "1.0",
        "updateComponents": {
          "surfaceId": "s_v10_comp_meta_replace",
          "components": [
            {
              "id": "root",
              "component": "Text",
              "text": "Hello",
              "metadata": {
                "extensions": {
                  "com_example_state": "final"
                }
              }
            }
          ]
        }
      }
    ],
    "expect": {
      "surfaces": {
        "s_v10_comp_meta_replace": {
          "exists": true,
          "components": [
            {
              "id": "root",
              "component": "Text",
              "text": "Hello",
              "@metadata": {
                "extensions": {
                  "com_example_state": "final"
                }
              }
            }
          ]
        }
      }
    }
  },
  {
    "name": "test_v10_update_components_omitted_metadata_clears_component_metadata",
    "description": "Tests that a v1.0 updateComponents entry without metadata clears the component's previously stored metadata, because an update replaces the definition in full.",
    "action": "process_messages",
    "protocolVersion": "1.0",
    "catalogPaths": [
      "catalogs/basic/v1/catalog.json"
    ],
    "messages": [
      {
        "version": "1.0",
        "createSurface": {
          "surfaceId": "s_v10_comp_meta_clear",
          "catalogId": "test-catalog-v10"
        }
      },
      {
        "version": "1.0",
        "updateComponents": {
          "surfaceId": "s_v10_comp_meta_clear",
          "components": [
            {
              "id": "root",
              "component": "Text",
              "text": "Hello",
              "metadata": {
                "extensions": {
                  "com_example_trace": "t1"
                }
              }
            }
          ]
        }
      },
      {
        "version": "1.0",
        "updateComponents": {
          "surfaceId": "s_v10_comp_meta_clear",
          "components": [
            {
              "id": "root",
              "component": "Text",
              "text": "Hello"
            }
          ]
        }
      }
    ],
    "expect": {
      "surfaces": {
        "s_v10_comp_meta_clear": {
          "exists": true,
          "components": [
            {
              "id": "root",
              "component": "Text",
              "text": "Hello",
              "@metadata": null
            }
          ]
        }
      }
    }
  }
]

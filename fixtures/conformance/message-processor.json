[
  {
    "name": "test_v10_create_surface_inline_initialization",
    "description": "Tests v1.0 createSurface message with inline components and initial dataModel initialization.",
    "action": "process_messages",
    "protocolVersion": "1.0",
    "catalogPaths": [
      "catalogs/basic/v1/catalog.json"
    ],
    "messages": [
      {
        "version": "1.0",
        "createSurface": {
          "surfaceId": "s_v10",
          "catalogId": "test-catalog-v10",
          "sendDataModel": true,
          "components": [
            {
              "id": "root",
              "component": "Column",
              "children": [
                "text1"
              ]
            },
            {
              "id": "text1",
              "component": "Text",
              "text": "Inline Text"
            }
          ],
          "dataModel": {
            "counter": 42
          }
        }
      }
    ],
    "expect": {
      "surfaces": {
        "s_v10": {
          "exists": true,
          "sendDataModel": true,
          "components": [
            {
              "id": "root",
              "component": "Column",
              "children": [
                "text1"
              ]
            },
            {
              "id": "text1",
              "component": "Text",
              "text": "Inline Text"
            }
          ],
          "dataModel": {
            "counter": 42
          }
        }
      }
    }
  },

[
  {
    "name": "test_validator_1_0",
    "features": [
      "F-CORE-07",
      "F-CORE-11"
    ],
    "description": "Tests schema validation of v1.0 message envelopes (inline components, optional catalogId, data deletion) against the basic v1.0 catalog schema.",
    "action": "validate",
    "protocolVersion": "1.0",
    "catalogPaths": [
      "catalogs/basic/v1/catalog.json"
    ],
    "steps": [
      {
        "messages": [
          {
            "version": "1.0",
            "createSurface": {
              "surfaceId": "s1",
              "catalogId": "https://a2ui.org/catalogs/basic/v1/catalog.json",
              "sendDataModel": true,
              "components": [
                {
                  "id": "root",
                  "component": "Text",
                  "text": "Inline Text"
                }
              ],
              "dataModel": {
                "counter": 100
              }
            }
          }
        ]
      },
      {
        "messages": [
          {
            "version": "1.0",
            "createSurface": {
              "surfaceId": "s_nocat"
            }
          }
        ]
      },
      {
        "messages": [
          {
            "version": "1.0",
            "updateDataModel": {
              "surfaceId": "s1",
              "path": "/user/token",
              "value": null
            }
          }
        ]
      },
      {
        "messages": [
          {
            "createSurface": {
              "surfaceId": "s1"
            }
          }
        ],
        "expectError": {
          "category": "ValidationError",
          "details": [
            {
              "path": "messages.0.version",
              "code": "missing_field"
            }
          ]
        }
      },
      {
        "messages": [
          {
            "version": "1.0",
            "createSurface": {
              "surfaceId": 123
            }
          }
        ],
        "expectError": {
          "category": "ValidationError",
          "details": [
            {
              "path": "messages.0.createSurface.surfaceId",
              "code": "type_mismatch"
            }
          ]
        }
      }
    ]
  }
]
